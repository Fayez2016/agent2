# Deep Agent Environment Configuration

# 1. Ansible Backend Mode Selection ('mock' or 'prd')
ANSIBLE_BACKEND_MODE=mock

# 2. Mock AAP Settings (used when ANSIBLE_BACKEND_MODE=mock)
AAP_HOST_MOCK=aap-server:5000
AAP_TOKEN_MOCK=mock-token-123

# 3. Production AAP Settings (used when ANSIBLE_BACKEND_MODE=prd)
AAP_HOST_PRD=https://aap.prd.enterprise.local
AAP_TOKEN_PRD=production-bearer-token-here
AAP_VERIFY_SSL=true

# 4. Ollama LLM Configuration
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma4:12b

# 5. MCP Server & Security Configuration
MCP_SERVER_URL=http://ansible-mcp:8000/mcp
DATABASE_URL=postgresql://hermes:secret456@db:5432/hitl
SECRET_KEY=hitl-secret-key-123
API_SERVER_KEY=hermes-api-secret
API_PORT=8642
